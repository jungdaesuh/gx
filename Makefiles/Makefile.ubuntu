# Makefile for GX on Ubuntu
# Uses NVIDIA packages from developer.download.nvidia.com
#
# to add these packages:
#
# wget https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/cuda-keyring_1.1-1_all.deb
# sudo dpkg -i cuda-keyring_1.1-1_all.deb
# sudo apt-get update
#
# then
#
# sudo apt-get install cuda-toolkit-13 cutensor-cuda-13 libnccl-dev
# sudo apt-get install libnetcdf-mpi-dev libgsl-dev
#
# add /usr/local/cuda/bin to PATH
#
# export PATH=/usr/local/cuda/bin:$PATH
#
# Do NOT install the Ubuntu nvidia packages (nvidia-cuda-toolkit and associated)
#
# Maintainer: iabel@umd.edu

NETCDF_ROOT = /usr/lib/x86_64-linux-gnu/netcdf/mpi
HDF5_ROOT = /usr/lib/x86_64-linux-gnu/hdf5/openmpi
NETCDF_INC = -I ${NETCDF_ROOT}/include
NETCDF_LIB = -L ${NETCDF_ROOT}/lib -lnetcdf -L${HDF5_ROOT}/lib -lhdf5


MPI_INC= -I/usr/lib/x86_64-linux-gnu/openmpi/include/
MPI_LIB= -L/usr/lib/x86_64-linux-gnu/openmpi/lib -lmpi

GSL_LIB = -lgsl -lgslcblas

CUDAARCH=75
CUTENSOR_INC =
CUTENSOR_LIB = -lcutensor -lcudart

CUDA_INC = ${CUTENSOR_INC}
CUDA_LIB = -L/usr/local/cuda/lib64 -lcufft_static -lculibos -lcublas -lcusolver ${CUTENSOR_LIB} -lnccl

CXX = g++

C_LIB = -ldl -lm -lpthread

CFLAGS = -fPIC

NVCC=nvcc

NVCCFLAGS = --forward-unknown-to-host-compiler -arch=compute_${CUDAARCH} -code=sm_${CUDAARCH} -use_fast_math -prec-sqrt=true -fPIC -rdc=true

ifeq ($(debug),on)
  NVCCFLAGS += -g -G
else
  NVCCFLAGS += -O3
endif
